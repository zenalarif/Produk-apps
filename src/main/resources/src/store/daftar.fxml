<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas_controller.DaftarController"
            stylesheets="">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label text="Daftar Produk Toko" styleClass="title"/>
            <TextField fx:id="txtCari" promptText="Cari berdasarkan nama produk"
                       onAction="#onCari"/>
            <FlowPane hgap="10" vgap="8">
                <Button text="Cari" onAction="#onCari"/>
                <Button text="Tambah" onAction="#onTambah"
                        styleClass="button-primary"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="kolNo" text="No" prefWidth="50" sortable="false"/>
                <TableColumn fx:id="kolKode" text="Kode" prefWidth="100"/>
                <TableColumn fx:id="kolNama" text="Nama Produk" prefWidth="230"/>
                <TableColumn fx:id="kolKategori" text="Kategori" prefWidth="130"/>
                <TableColumn fx:id="kolHarga" text="Harga (Rp)" prefWidth="130"/>
                <TableColumn fx:id="kolAksi" text="Aksi" prefWidth="140" sortable="false"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
