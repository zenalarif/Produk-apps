<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="kelas_controller.DetailController">
   <padding>
      <Insets top="40.0" right="32.0" bottom="28.0" left="32.0" />
   </padding>

   <VBox styleClass="kartu" spacing="22.0" maxWidth="620.0">
      <Label text="Detail Produk" styleClass="judul-halaman" />

      <HBox spacing="30.0">
         <StackPane styleClass="foto-placeholder" prefWidth="190.0" prefHeight="190.0"
                    minWidth="190.0" minHeight="190.0" maxHeight="190.0">
            <Label fx:id="lblFoto" text="Foto Produk" styleClass="label-field" />
            <ImageView fx:id="imgProduk" fitWidth="190.0" fitHeight="190.0" preserveRatio="true" />
         </StackPane>

         <VBox spacing="4.0">
            <Label text="Kode Produk" styleClass="label-field" />
            <Label fx:id="lblKode" styleClass="nilai-field" />

            <Label text="Nama Produk" styleClass="label-field">
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="lblNama" styleClass="nilai-field" wrapText="true" />

            <Label text="Kategori" styleClass="label-field">
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </Label>
            <HBox>
               <Label fx:id="lblKategori" styleClass="chip" />
            </HBox>

            <Label text="Harga" styleClass="label-field">
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="lblHarga" styleClass="nilai-field" />
         </VBox>
      </HBox>

      <HBox alignment="CENTER_RIGHT">
         <Button text="Tutup" styleClass="tombol-utama" onAction="#onTutup" />
      </HBox>
   </VBox>
</VBox>
